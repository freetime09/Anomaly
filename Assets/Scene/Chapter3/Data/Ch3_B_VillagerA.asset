  lines:
  - speakerId: Villager_A
    text: "\uC5B4\uC774\uCFE0, \uCC98\uC74C \uBCF4\uB294 \uAF2C\uB9C8\uB85C\uAD6C\uB098.
      \uAE38\uC774\uB77C\uB3C4 \uC783\uC5C8\uB2C8?"
    holdTime: 0
  - speakerId: Mecro
    text: "\uC544\uC800\uC528! \uC800\uC608\uC694, \uBA54\uD06C\uB85C! \uBC14\uB85C
      \uC606\uC9D1 \uC0AC\uB294!"
    holdTime: 0
  - speakerId: Villager_A
    text: "<glitch>\uBA54\uD06C\uB85C</glitch>...? \uBBF8\uC548\uD558\uB2E4, \uADF8\uB7F0
      \uC774\uB984\uC740 \uCC98\uC74C \uB4E4\uC5B4\uBCF4\uB294\uAD6C\uB098."
    holdTime: 0
