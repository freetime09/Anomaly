    gap: 0.35
    textSpeed: 24
    quoteLead: 0.45
    quoteDuration: 2.1
    push: 0.022
    drift: {x: -6, y: 0}
  - id: 3
    narration: "\uADF8\uB7F0\uB370, \uAC11\uC790\uAE30 \uD558\uB298\uC5D0\uC11C \uCEE4\uB2E4\uB780
      \uB208\uC774 \uB098\uD0C0\uB098\uC11C\n\uB9D0\uD588\uC5B4\uC694."
    quote: "\uC544 \uC774\uC81C \uC774\uAC74 \uC0AD\uC81C \uD574\uC57C\uACA0\uB2E4"
    illustration: {fileID: 3014716621760928512, guid: 6a39e5d45d004bf47acb3592f25c4721, type: 3}
    minimumDuration: 8
    narrationDuration: 2.8
    sentencePause: 0.85
