    drift: {x: 4, y: 0}
  - id: 4
    narration: "\uADF8 \uB9D0\uC774 \uB098\uC628 \uC9C1\uD6C4,\n\uC138\uACC4\uAC00
      \uAC11\uC790\uAE30 \uC9C4\uC9DC \uC0AC\uB77C\uC9C0\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694."
