  cuts:
  - id: 1-1
    narration: "\uC5B4\uB290 \uB9C8\uC744\uC5D0\uC11C \uC81C\uC77C\uAC00\uB294 \uAC1C\uAD6C\uC7C1\uC774
      \uC18C\uB144\uC774 \uC788\uC5C8\uB2F5\uB2C8\uB2E4.\n\uADF8 \uC18C\uB144\uC758
      \uC774\uB984\uC740 \uBA54\uD06C\uB85C."
    quote: 
    illustration: {fileID: 1251241993294252591, guid: 8b32470c468be284ab049311b561dc9f, type: 3}
    minimumDuration: 8
    narrationDuration: 3
    sentencePause: 0.85
    quoteSettle: 0.35
    fadeIn: 1.05
    fadeOut: 0.8
    imageLead: 0.35
    hold: 2.8
    gap: 0.25
    textSpeed: 26
    quoteLead: 0.45
    quoteDuration: 2.1
    push: 0.022
    drift: {x: 4, y: 0}
  - id: 1-2
    narration: "\uADF8\uB294 \uC0B0 \uD0C0\uB294 \uAC78 \uC815\uB9D0 \uC88B\uC544\uD588\uC5B4\uC694."
    quote: 
    illustration: {fileID: 2178390891028426014, guid: a85a76fa42db5614ebdcf51d7508b5ed, type: 3}
    minimumDuration: 7
    narrationDuration: 2
    sentencePause: 0.85
    quoteSettle: 0.35
    fadeIn: 0.75
    fadeOut: 0.55
    imageLead: 0.2
    hold: 1.8
    gap: 0.18
    textSpeed: 29
    quoteLead: 0.45
    quoteDuration: 2.1
    push: 0.022
    drift: {x: 10, y: 0}
  - id: 2
    narration: "\uADF8\uB798\uC11C \uD3C9\uC18C\uCC98\uB7FC \uC0B0 \uC815\uC0C1\uC5D0
      \uC62C\uB77C\uC628 \uBA54\uD06C\uB85C\uB294\n\uACBD\uCE58\uB97C \uAD6C\uACBD
      \uD588\uC8E0."
    quote: 
    illustration: {fileID: -6014875715913232297, guid: a59557f5d344a1d438720bf5a7d8febc, type: 3}
    minimumDuration: 8
    narrationDuration: 3.3
    sentencePause: 0.85
    quoteSettle: 0.35
